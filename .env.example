EDGE_MODEL_SOURCE=hf
EDGE_MODEL_ID=TinyLlama/TinyLlama-1.1B-Chat-v1.0
EDGE_QUANTIZED_MODEL_ID=TheBloke/TinyLlama-1.1B-Chat-v1.0-GPTQ
EDGE_QUANTIZATION=int4-gp32
EDGE_LOCAL_DIR=
EDGE_MAX_INPUT_TOKENS=1400
EDGE_MAX_NEW_TOKENS=220
EDGE_TEMPERATURE=0.7
EDGE_TOP_P=0.95
EDGE_TOP_K=0
EDGE_QUANT_BITS=4
EDGE_QUANT_GROUP_SIZE=32
EDGE_USE_SAMPLING=true

# 端侧 embedding（ModelScope 默认）
# 取值：modelscope（走 snapshot_download）或任意其他值（跳过下载，直接 from_pretrained）
EDGE_EMBEDDING_SOURCE=modelscope
EDGE_EMBEDDING_MODEL_ID=google/embeddinggemma-300m
# 留空时 modelscope 缓存落在 /tmp/modelscope_embedding_cache，macOS 重启会被清空，
# 导致 1.1GB 权重反复重下。建议指向持久目录（如 <repo>/models/google/embeddinggemma-300m）。
# 注意：该值同时被 _resolve_model_id 当作「可直接加载的模型目录」，又被
# _download_if_modelscope 当作「modelscope 缓存根目录」——两种语义冲突。
# 若填此项，请同时把 EDGE_EMBEDDING_SOURCE 设为非 modelscope（如 local），
# 否则启动时会先拿本地路径当模型 ID 去下载、失败后再回退，多出一条误导性 warning。
EDGE_EMBEDDING_LOCAL_DIR=
EDGE_EMBEDDING_MAX_LENGTH=512
EDGE_EMBEDDING_BATCH_SIZE=8
EDGE_EMBEDDING_TRUST_REMOTE_CODE=true
# 注意：Apple Silicon 上 device_map="auto" 会落到 MPS，而 embeddinggemma-300m
# 在 MPS + float16 下会输出 NaN 向量；该平台请改用 bfloat16。
# CUDA 环境保持 float16 即可。
# 另：embedding_runtime._dtype() 的兜底分支目前返回 float16，
# 因此 float32 实际不可达，只有 bfloat16/bf16 与 float16/fp16 两种取值生效。
EDGE_EMBEDDING_TORCH_DTYPE=float16

CLOUD_API_BASE=http://127.0.0.1:8000/v1
CLOUD_API_KEY=
CLOUD_MODEL_ID=google/gemma-4-e2b-it
CLOUD_ENABLED=false
CLOUD_TIMEOUT_SECONDS=20
CLOUD_MAX_NEW_TOKENS=512
CLOUD_TEMPERATURE=0.5

ROUTE_MAX_INPUT_CHARS=1800
ROUTE_MIN_EDGE_CONFIDENCE=0.50

# 报销场景最小闭环开关
EXPENSE_STORE_PATH=data/expense_store.jsonl
EXPENSE_DEFAULT_CLAIM_ID=default-claim
EXPENSE_REQUIRED_DOC_TYPES=invoice,bank_transfer,receipt,approval
EXPENSE_MAX_SEARCH_LIMIT=50
EXPENSE_ENABLE_EMBEDDING_SEARCH=true
EXPENSE_WATCH_DIR=
EXPENSE_WATCH_INTERVAL_SECONDS=120
EXPENSE_WATCH_FILE_SUFFIXES=.txt,.md,.json,.csv,.log,.pdf,.png,.jpg,.jpeg
EXPENSE_WATCH_RECURSIVE=true

# 路由策略：默认端侧优先；设置 false 时直接走云端（当 CLOUD_ENABLED=true）
ROUTE_USE_TINYLLM=true

# 全量个人文件搜索（v1）
FILE_MEMORY_STORE_PATH=data/personal_file_store.jsonl
FILE_MEMORY_SOURCE_DIR=
FILE_MEMORY_SCAN_INTERVAL_SECONDS=120
FILE_MEMORY_SCAN_FILE_SUFFIXES=.txt,.md,.json,.csv,.log,.pdf,.doc,.docx,.ppt,.pptx,.xls,.xlsx,.png,.jpg,.jpeg,.gif,.bmp,.webp,.mp4,.mov,.m4a,.mp3,.wav
FILE_MEMORY_SCAN_RECURSIVE=true
FILE_MEMORY_TOP_K_DEFAULT=8
FILE_MEMORY_MAX_QUERY_LEN=120
FILE_MEMORY_ENABLE_FAISS=true
FILE_MEMORY_FAISS_INDEX_PATH=data/personal_file_faiss.index
FILE_MEMORY_FAISS_CANDIDATE_MULTIPLIER=4
FILE_MEMORY_FAISS_TEXT_WEIGHT=0.65
FILE_MEMORY_FAISS_SEMANTIC_WEIGHT=0.30
FILE_MEMORY_FAISS_CLUE_WEIGHT=0.25
FILE_MEMORY_FAISS_VERSION_BONUS=0.20

# 日志配置
APP_LOG_LEVEL=INFO

# 说明：当前默认是端侧 tiny llm-only 运行，CLOUD_ENABLED=true 时启用 Gemma4 兜底
