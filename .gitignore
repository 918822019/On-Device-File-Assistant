# ---- Python 虚拟环境 ----
.venv/
.venv-*/
venv/
env/

# ---- Python 缓存与构建产物 ----
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ---- 本地环境变量（含密钥，切勿入库；模板见 .env.example）----
.env
.env.local
.env.*.local

# ---- 运行时数据：向量索引、JSONL 存储、模型缓存 ----
# 锚定仓库根，避免误伤 android/.../runtime/data/ 下的 Kotlin 源码
/data/
*.index
*.index.ids.json
# 本地模型权重（embeddinggemma-300m 约 1.2GB），不入库
models/
model_cache/
.modelscope_cache/
# modelscope 下载中断残留
._____temp/

# ---- Android / Gradle ----
android/build/
android/app/build/
android/.gradle/
android/.kotlin/
# 内含本机 SDK 路径，Gradle 官方要求不入库
android/local.properties
*.apk
*.aab
*.keystore
!debug.keystore

# ---- IDE ----
.idea/
*.iml.bak

# ---- 工具/会话产物 ----
.omo/

# tiny-llm 工具链的中间产物。make_fake_qwen35_model.py 之类会把 HF state_dict
# 写到**当前工作目录**（--hf-out 的默认值），在仓库根跑就会落一个 fake35_hf.pt。
# .tqwen 是导出后的模型二进制，同样不该入库。
*.tqwen
fake*_hf.pt

# ---- macOS ----
.DS_Store
.AppleDouble
.LSOverride

# ---- 日志 ----
*.log
logs/

# ---- 部署（PID 托管模式，见 scripts/service.sh）----
.server.pid
